<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StrawberryShake.Server" Version="16.7.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
  <!-- dotnet run -p:WithFix=true : swap in the transport from ../../fix -->
  <ItemGroup Condition="'$(WithFix)' == 'true'">
    <PackageReference Include="StrawberryShake.Transport.Http" Version="16.7.5" ExcludeAssets="compile;runtime" />
    <ProjectReference Include="../../fix/StrawberryShake.Transport.Http/StrawberryShake.Transport.Http.csproj" />
  </ItemGroup>
</Project>
